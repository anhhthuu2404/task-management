<Project Sdk="Microsoft.NET.Sdk.Web">
	<Import Project="..\..\common.props" />
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
		<RootNamespace>TaskManagement</RootNamespace>
		<PreserveCompilationReferences>true</PreserveCompilationReferences>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(RunConfiguration)' == 'TaskManagement.HttpApi.Host' " />
	<ItemGroup>
		<PackageReference Include="AspNetCore.HealthChecks.UI" Version="9.0.0" />
		<PackageReference Include="AutoMapper" Version="16.2.0" />
		<PackageReference Include="AutoMapper.Collection" Version="13.0.0" />
		<PackageReference Include="KubernetesClient" Version="18.0.5" />
		<PackageReference Include="IdentityModel" Version="7.0.0" />
		<PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
		<PackageReference Include="AspNetCore.HealthChecks.UI.InMemory.Storage" Version="9.0.0" />
		<PackageReference Include="MessagePack" Version="3.1.8" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
		<PackageReference Include="Scriban" Version="7.2.6" />
		<PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
		<PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Volo.Abp.AspNetCore.MultiTenancy" Version="10.0.0" />
		<PackageReference Include="Volo.Abp.Autofac" Version="10.0.0" />
		<PackageReference Include="Volo.Abp.AspNetCore.Serilog" Version="10.0.0" />
		<PackageReference Include="Volo.Abp.Swashbuckle" Version="10.0.0" />

		<!-- Bổ sung gói Background Workers cho dự án Host -->
		<PackageReference Include="Volo.Abp.BackgroundWorkers" Version="10.0.0" />

		<!-- Bổ sung các package Identity và Permission Management cho Backend -->
		<PackageReference Include="Volo.Abp.Identity.HttpApi" Version="10.0.0" />
		<PackageReference Include="Volo.Abp.Identity.Application" Version="10.0.0" />
		<PackageReference Include="Volo.Abp.PermissionManagement.HttpApi" Version="10.0.0" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Volo.Abp.Account.Web.OpenIddict" Version="10.0.0" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Volo.Abp.AspNetCore.Mvc.UI.Theme.LeptonXLite" Version="5.0.0" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\TaskManagement.Application\TaskManagement.Application.csproj" />
		<ProjectReference Include="..\TaskManagement.HttpApi\TaskManagement.HttpApi.csproj" />
		<ProjectReference Include="..\TaskManagement.EntityFrameworkCore\TaskManagement.EntityFrameworkCore.csproj" />
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="Volo.Abp.Studio.Client.AspNetCore" Version="2.0.2" />
	</ItemGroup>
	<ItemGroup>
		<Compile Remove="Logs\**" />
		<Content Remove="Logs\**" />
		<EmbeddedResource Remove="Logs\**" />
		<None Remove="Logs\**" />
	</ItemGroup>
</Project>